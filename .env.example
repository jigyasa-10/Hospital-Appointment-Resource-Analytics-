# Copy this file to ".env" and edit the values.

# Server name exactly as shown in the SSMS "Connect to Server" box.
# Examples:  localhost   |   .\SQLEXPRESS   |   DESKTOP-ABC123\SQLEXPRESS
DB_SERVER=localhost\SQLEXPRESS

DB_NAME=HospitalAnalytics

# Leave DB_USER empty to use Windows Authentication (most common in SSMS).
# Fill both to use SQL Server Authentication (for example the "sa" login).
DB_USER=
DB_PASSWORD=

# Optional. Leave empty and the newest installed "ODBC Driver N for SQL Server" is used.
DB_DRIVER=

PORT=5000
